# ============================================================
# توکن تلگرام (اجباری)
# ============================================================
# توکنی که از @BotFather گرفتی
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# ============================================================
# ادمین‌ها (اختیاری)
# ============================================================
# آیدی عددی ادمین‌ها با کاما جدا. مثال: 123456789,987654321
ADMIN_IDS=


# ============================================================
# AI / Groq / DeepSeek
# ============================================================
# کلید Groq (یا DeepSeek). config.py هر دو نام را می‌شناسد.
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# مدل Groq (یا DeepSeek)
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat

# آدرس پایه DeepSeek (اختیاری، config.py خودش groq_base_url را ست می‌کند)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (اختیاری)
OPENAI_API_KEY=

# Tavily (اختیاری، برای جستجوی وب)
TAVILY_API_KEY=


# ============================================================
# Media
# ============================================================
# Unsplash (اختیاری، برای تصاویر)
UNSPLASH_ACCESS_KEY=

# Pollinations (اختیاری، برای تولید تصویر)
POLLINATIONS_API_KEY=


# ============================================================
# پایگاه داده
# ============================================================
# برای لوکال: sqlite
DATABASE_URL=sqlite+aiosqlite:///./taghziye_yar.db
# برای Render: از Postgres استفاده کن، مثلاً:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname


# ============================================================
# تنظیمات عمومی
# ============================================================
LOG_LEVEL=INFO
MOCK_MODE=false


# ============================================================
# شخصی‌سازی
# ============================================================
BOT_DISPLAY_NAME=تغذیه‌یار
SIGNATURE=🌱 تغذیه‌یار | دستیار هوشمند شما


# ============================================================
# Webhook / Server
# ============================================================
# اگر خالی باشد، بات در حالت polling اجرا می‌شود.
# در Render باید URL کامل سرویس را بدهی، مثلاً:
# WEBHOOK_URL=https://taghziyeyar-bot.onrender.com
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=

PORT=8080
RATE_LIMIT_SECONDS=2.0


# ============================================================
# MCP Endpoints (Digikala / Torob / SnappShop)
# ============================================================
# ⚠️ مهم: در Render، localhost به خودِ کانتینر بات اشاره می‌کند
# و به سرورهای MCP دسترسی ندارد. باید آدرس واقعی و عمومی
# سرورهای MCP را بدهی.
#
# نمونه لوکال (توسعه):
# MCP_DIGIKALA_URL=http://localhost:8000/mcp
# MCP_TOROB_URL=http://localhost:8001/mcp
# MCP_SNAPP_SHOP_URL=http://localhost:8002/mcp
#
# نمونه Render (وقتی MCPها روی Render دیپلوی شده‌اند):
# MCP_DIGIKALA_URL=https://your-digikala-mcp.onrender.com/mcp
# MCP_TOROB_URL=https://your-torob-mcp.onrender.com/mcp
# MCP_SNAPP_SHOP_URL=https://your-snappshop-mcp.onrender.com/mcp

MCP_DIGIKALA_URL=http://localhost:8000/mcp
MCP_TOROB_URL=http://localhost:8001/mcp
MCP_SNAPP_SHOP_URL=http://localhost:8002/mcp

# فعال/غیرفعال کردن هر فروشگاه
MCP_DIGIKALA_ENABLED=true
MCP_TOROB_ENABLED=true
MCP_SNAPP_SHOP_ENABLED=true

# تایم‌اوت‌ها (ثانیه)
MCP_TIMEOUT_SECONDS=20
MCP_CONNECT_TIMEOUT_SECONDS=10

# بررسی سلامت سرور قبل از هر جستجو
MCP_HEALTHCHECK_ENABLED=true


# ============================================================
# BlackHunt / AutoHunter
# ============================================================
AUTO_HUNTER_ENABLED=true
AUTO_HUNTER_MIN_DISCOUNT=90
AUTO_HUNTER_INTERVAL_SECONDS=300
AUTO_HUNTER_MAX_RESULTS_PER_STORE=6
