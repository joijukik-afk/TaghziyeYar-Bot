# ============ توکن تلگرام (اجباری) ============
# توکنی که از @BotFather گرفتی
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ============ ادمین‌ها (اختیاری) ============
# آیدی عددی ادمین‌ها با کاما جدا. مثال: 123456789,987654321
ADMIN_IDS=

# ============ DeepSeek API (برای فاز ۳) ============
# فعلاً خالی بذار
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ پایگاه داده ============
DATABASE_URL=sqlite+aiosqlite:///./taghziye_yar.db

# ============ تنظیمات عمومی ============
LOG_LEVEL=INFO
MOCK_MODE=false

# ============ شخصی‌سازی ============
BOT_DISPLAY_NAME=تغذیه‌یار
SIGNATURE=🥗 متخصص علی اکبر ابراهیم پور
